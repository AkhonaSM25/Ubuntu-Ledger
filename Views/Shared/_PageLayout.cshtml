@{
    Layout = "_Layout";
}
@* Full-page layout for screens outside any circle (choosing or starting one). *@
<div class="page">
    <header class="topbar">
        <partial name="_Brand" model="(true, false, false)" />
        <form method="post" asp-controller="Account" asp-action="Logout">
            <button type="submit" class="signout" style="min-height:44px;padding:0 12px">@Ui.Icon("signout", 20, 1.9)Sign out</button>
        </form>
    </header>
    <main class="page__body" id="main" tabindex="-1">
        <div class="page__inner stack" style="max-width:@(ViewData["MaxWidth"] ?? 760)px">
            @RenderBody()
            <p class="small muted legal-links"><a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></p>
        </div>
    </main>
</div>
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
