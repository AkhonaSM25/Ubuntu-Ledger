@model ConfirmationsViewModel
@{
    var access = (CircleAccess)ViewData["Access"]!;
    ViewData["Title"] = "Confirmations";
    ViewData["Nav"] = "payments";
    Layout = "_CircleLayout";
    var circleId = access.Circle.Id;
    var rows = Model.Tab == "mine" ? Model.Mine : Model.Others;
    var payerLabel = "Payer confirmed";
    var collectorLabel = "Collector confirmed";
}
<div class="page-head">
    <div class="page-head__text">
        <p class="eyebrow">Two-party confirmation</p>
        <h1 class="page-title">Pending confirmations</h1>
        <p class="page-sub">Payments do not change balances until both people confirm.</p>
    </div>
    <div class="actions">
        <a class="btn btn--primary" asp-action="Create" asp-route-circleId="@circleId">@Ui.Icon("plus", 20, 2.1)@(access.IsTreasurer ? "I received a payment" : "I made a payment")</a>
    </div>
</div>
<nav class="filter-chips" aria-label="Which payments">
    <a class="filter-chip" asp-action="Index" asp-route-circleId="@circleId" aria-pressed="@(Model.Tab == "mine" ? "true" : "false")">Needs my confirmation · @Model.Mine.Count</a>
    <a class="filter-chip" asp-action="Index" asp-route-circleId="@circleId" asp-route-tab="others" aria-pressed="@(Model.Tab == "others" ? "true" : "false")">Waiting on others · @Model.Others.Count</a>
</nav>
<div class="split">
    <section class="card split__main">
        @foreach (var r in rows)
        {
            var payerOk = r.Payment.SubmittedBy == PaymentSide.Payer;
            var collectorOk = r.Payment.SubmittedBy == PaymentSide.Collector;
            <a class="row row--tall" asp-action="Details" asp-route-circleId="@circleId" asp-route-id="@r.Payment.Id">
                @Ui.Avatar(r.Loan.Borrower.Initials)
                <span class="row__main">
                    <span class="row__title">@r.Headline</span>
                    <span class="row__sub">@r.Detail</span>
                    <span class="row__sub" style="display:flex;flex-wrap:wrap;gap:4px 14px">
                        <span class="mini-check@(payerOk ? " mini-check--on" : "")">@Ui.Icon("check", 14, 3)@payerLabel</span>
                        <span class="mini-check@(collectorOk ? " mini-check--on" : "")">@Ui.Icon("check", 14, 3)@collectorLabel</span>
                    </span>
                </span>
                <span class="row__end">@Ui.Chip(r.Chip, r.ChipLabel)<span class="row__amt">@Format.Zar(r.Payment.Amount)</span></span>
                <span class="row__chev">@Ui.Icon("chevronRight", 18)</span>
            </a>
        }
        @if (rows.Count == 0)
        {
            <partial name="_EmptyState" model="@((Model.Tab == "mine" ? "Nothing needs your confirmation" : "Nothing is waiting on anyone else", (string?)"New payments will show up here.", "default"))" />
        }
    </section>
    <aside class="split__side stack">
        <p class="eyebrow" style="margin:0">Notifications</p>
        @foreach (var n in Model.Notices)
        {
            <a class="card card--pad notice-card notice-card--@n.Tone" asp-action="Details" asp-route-circleId="@circleId" asp-route-id="@n.PaymentId">
                <strong>@n.Title</strong>
                <span class="small muted">@n.Text</span>
                <span class="small" style="font-weight:700">Review now →</span>
            </a>
        }
        @if (Model.Notices.Count == 0)
        {
            <p class="small muted">You are all caught up.</p>
        }
    </aside>
</div>
