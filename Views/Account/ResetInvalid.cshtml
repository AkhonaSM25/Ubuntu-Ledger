@{
    ViewData["Title"] = "Reset link not valid";
}
<div class="page">
    <main class="page__body" id="main" tabindex="-1">
        <div class="page__inner stack" style="max-width:560px">
            <partial name="_Brand" model="(false, false, true)" />
            <div>
                <h1 class="page-title">This reset link has expired</h1>
