@{
    ViewData["Title"] = "Invite link not valid";
}
<div class="page">
    <main class="page__body" id="main" tabindex="-1">
        <div class="page__inner stack" style="max-width:560px">
            <partial name="_Brand" model="(false, false, true)" />
            <div>
                <h1 class="page-title">This invite link is not valid</h1>
                <p class="page-sub">It may have been used already, or the treasurer cancelled it. Ask your treasurer to send you a new one.</p>
            </div>
            <a class="btn btn--primary" href="/login" style="align-self:flex-start">Go to sign in</a>
        </div>
    </main>
</div>
