@model LoanDetailViewModel
@{
    var access = (CircleAccess)ViewData["Access"]!;
    var s = Model.Summary;
    var loan = s.Loan;
    ViewData["Title"] = "Loan statement " + loan.Reference;
    ViewData["Print"] = true;
}
@* A printable statement; the browser's print dialog saves it as a PDF. *@
<div class="page">
    <main class="page__body" id="main" tabindex="-1">
        <div class="page__inner stack" style="max-width:860px">
            <div class="page-head">
                <div class="page-head__text">
                    <partial name="_Brand" model="(true, false, false)" />
                    <h1 class="page-title" style="margin-top:20px">Loan statement @loan.Reference</h1>
                    <p class="page-sub">@access.Circle.Name · @loan.Borrower.Name · as at @Format.Date(Model.Today)</p>
                </div>
                <div class="no-print" style="display:flex;gap:8px;flex-wrap:wrap">
                    <a class="btn btn--secondary btn--sm" asp-action="Details" asp-route-circleId="@access.Circle.Id" asp-route-id="@loan.Id">Back</a>
                    <button type="button" class="btn btn--primary btn--sm" data-print>@Ui.Icon("download", 18)Save as PDF</button>
                </div>
            </div>
            <section class="card card--pad">
                <div class="figures">
                    <div><div class="figure__label">Lent</div><div class="figure__value">@Format.Zar(loan.Principal)</div></div>
                    <div><div class="figure__label">Interest</div><div class="figure__value">@Format.Zar(s.Interest)</div></div>
                    <div><div class="figure__label">Paid</div><div class="figure__value">@Format.Zar(s.Paid)</div></div>
                    <div><div class="figure__label">Balance owing</div><div class="figure__value">@Format.Zar(s.Balance)</div></div>
                </div>
                <p class="small muted" style="margin:12px 0 0">@(loan.RatePercent.ToString("0.##"))% @(loan.InterestType == InterestType.Simple ? "simple" : "monthly") interest · @Format.Plural(loan.Term, "monthly payment") · instalment @Format.Zar(s.Instalment)@(s.NextDue is { } nd && s.Balance > 0 ? $" · next due {Format.Date(nd)}" : "")</p>
            </section>
            <section class="card card--pad" style="overflow-x:auto">
                <table class="statement">
                    <caption class="sr-only">Every entry on this loan, oldest first</caption>
                    <thead><tr><th scope="col">Date</th><th scope="col">Entry</th><th scope="col" class="num">Amount</th><th scope="col" class="num">Balance owing</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>@Format.Date(r.Date)</td>
                                <td><strong>@r.Title</strong><br /><span class="small muted">@r.Sub</span></td>
                                <td class="num">@(r.IsCredit ? "−" : "")@Format.Zar(r.Amount)</td>
                                <td class="num">@Format.Zar(r.Balance)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
            <p class="small muted">Only payments confirmed by both people count. Reversed entries stay on this statement with their reason. Generated by Ubuntu Ledger.</p>
        </div>
    </main>
</div>
