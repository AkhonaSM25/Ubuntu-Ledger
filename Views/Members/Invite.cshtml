@model InviteViewModel
@{
    var access = (CircleAccess)ViewData["Access"]!;
    ViewData["Title"] = "Invite someone";
    ViewData["Nav"] = "members";
    Layout = "_CircleLayout";
    var circleId = access.Circle.Id;
}
<a class="back-link" asp-action="Index" asp-route-circleId="@circleId">@Ui.Icon("chevronLeft")All members</a>
<div>
    <p class="eyebrow">@access.Circle.Name</p>
    <h1 class="page-title">Invite someone</h1>
    <p class="page-sub">Only people you add can join. Send them their invite on WhatsApp: the link lets them set a PIN and join. If they already have an account, the invite shows on their circles page.</p>
</div>
<div class="split">
    <form class="card card--pad form split__half" method="post" asp-action="Invite" asp-route-circleId="@circleId">
        <h2 class="section-title">Add a person</h2>
        <div data-contact-picker hidden style="display:flex;flex-direction:column;gap:20px">
            <button type="button" class="btn btn--dashed" data-pick-contact data-name="#Name" data-phone="#Phone">@Ui.Icon("contacts")Choose from my contacts</button>
            <div class="or-divider">or type it in</div>
        </div>
        <label class="field">
            <span>Name <span class="field__opt">(optional)</span></span>
            <input class="input" asp-for="Name" placeholder="e.g. Ayanda Cele" />
        </label>
        <label class="field">
            Phone number
            <input class="input" asp-for="Phone" type="tel" inputmode="tel" placeholder="e.g. 076 118 4420" />
            <span asp-validation-for="Phone"></span>
        </label>
        <button type="submit" class="btn btn--primary">@Ui.Icon("mail")Send invite</button>
    </form>
    <section class="card split__half">
        <div class="card__head">
            <h2 class="section-title">Waiting to accept</h2>
            <span class="count-pill count-pill--neutral">@Model.Pending.Count</span>
        </div>
        @foreach (var x in Model.Pending)
        {
            <div class="row row--76" style="padding-right:12px">
                @Ui.Avatar(x.Name.Any(char.IsLetter) ? PersonExtensions.InitialsOf(x.Name) : "?")
                <span class="row__main"><span class="row__title ellipsis">@x.Name</span><span class="row__sub">@PhoneNumber.Format(x.Phone)</span></span>
                @Ui.Chip("invited")
                @if (Model.ShareLinks.TryGetValue(x.Id, out var whatsapp))
                {
                    <a class="btn btn--secondary btn--xs" href="@whatsapp" target="_blank" rel="noopener">@Ui.Icon("mail", 18)WhatsApp<span class="sr-only"> invite to @x.Name</span></a>
                }
                <form class="inline-form" method="post" asp-action="CancelInvite" asp-route-circleId="@circleId" asp-route-id="@x.Id">
                    <button type="submit" class="icon-btn" aria-label="Cancel invite for @x.Name">@Ui.Icon("close")</button>
                </form>
            </div>
        }
        @if (Model.Pending.Count == 0)
        {
            <partial name="_EmptyState" model="@(("No one is waiting", (string?)"Invites you send show here until they are accepted.", "default"))" />
        }
    </section>
</div>
