@model MemberDetailViewModel
@{
    var access = (CircleAccess)ViewData["Access"]!;
    var p = Model.Member.Person;
    ViewData["Title"] = p.Name;
    ViewData["Nav"] = "members";
    Layout = "_CircleLayout";
    var circleId = access.Circle.Id;
}
<a class="back-link" asp-action="Index" asp-route-circleId="@circleId">@Ui.Icon("chevronLeft")All members</a>
<section class="card card--pad geo-host">
    @Ui.Geo(right: true, opacity: 0.8)
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px">
        @Ui.Avatar(p.Initials, "big")
        <div style="flex:1 1 220px;min-width:0">
            <div class="title-row"><h1 class="page-title">@p.Name</h1>@Ui.Chip(Model.Member.Status)</div>
            <p class="page-sub">Member since @Format.MonthYear(Model.MemberSince) · @PhoneNumber.Format(p.Phone)</p>
        </div>
        <a class="btn btn--primary btn--sm" asp-controller="Loans" asp-action="Create" asp-route-circleId="@circleId" asp-route-borrowerId="@p.Id">@Ui.Icon("plus", 18, 2.1)New loan</a>
    </div>
</section>
@if (Model.ResetLink is not null)
{
    <section class="card card--pad form" aria-labelledby="reset-link-title">
        <div>
            <h2 class="section-title" id="reset-link-title">PIN reset link for @p.FirstName</h2>
            <p class="small muted" style="margin-top:4px">Send it only to @p.FirstName. It works once and expires in two days. @p.FirstName chooses the new PIN, so you never see it. This link is shown once: if you lose it, make a new one.</p>
        </div>
        <label class="field">
            <span>Link</span>
            <input class="input" readonly value="@Model.ResetLink" data-select />
        </label>
        <div class="form-actions" style="justify-content:flex-start">
            <a class="btn btn--primary" href="@Model.ResetWhatsAppUrl" target="_blank" rel="noopener">@Ui.Icon("mail", 20)Send on WhatsApp</a>
        </div>
    </section>
}
<partial name="_StatGrid" model="Model.Stats" />
@if (Model.CanResetPin)
{
    <section class="card card--pad">
        <details class="corrections">
            <summary>@p.FirstName forgot their PIN?</summary>
            <form method="post" asp-action="ResetPin" asp-route-circleId="@circleId" asp-route-personId="@p.Id" class="form">
                <p class="small muted" style="margin:0">Make a one-time link and send it to @p.FirstName. They pick a new PIN themselves.</p>
                <div><button type="submit" class="btn btn--secondary">Make a reset link</button></div>
            </form>
        </details>
    </section>
}
@if (Model.CanManage)
{
    <section class="card card--pad">
        <details class="corrections">
            <summary>Manage @p.FirstName@(Model.IsBackup ? " · backup treasurer" : "")</summary>
            <div class="form">
                <form method="post" asp-action="Backup" asp-route-circleId="@circleId" asp-route-personId="@p.Id" class="form">
                    <input type="hidden" name="appoint" value="@(Model.IsBackup ? "false" : "true")" />
                    <p class="small muted" style="margin:0">@(Model.IsBackup
                        ? $"{p.FirstName} can make you a PIN reset link if you forget your PIN. They have no other extra powers."
                        : $"Choose someone you trust. If you forget your own PIN, {p.FirstName} can make you a one-time reset link. They get no other extra powers, and only one person can be backup.")</p>
                    <div><button type="submit" class="btn btn--secondary">@(Model.IsBackup ? "Remove as backup treasurer" : "Make backup treasurer")</button></div>
                </form>
                <form method="post" asp-action="Remove" asp-route-circleId="@circleId" asp-route-personId="@p.Id" class="form divider-top">
                    <p class="small muted" style="margin:0">Remove @p.FirstName from @access.Circle.Name. This only works when they owe nothing and have no payment waiting. Their past loans and payments stay in the history.</p>
                    <div><button type="submit" class="btn btn--danger">Remove @p.FirstName</button></div>
                </form>
            </div>
        </details>
    </section>
}
<div class="two-col">
    <section class="card">
        <div class="card__head"><h2 class="section-title">Loan history</h2></div>
        @foreach (var l in Model.Member.Loans.OrderByDescending(l => l.Loan.StartDate))
        {
            <a class="row row--76" asp-controller="Loans" asp-action="Details" asp-route-circleId="@circleId" asp-route-id="@l.Loan.Id">
                <span class="avatar avatar--44 avatar--icon">@Ui.Icon("wallet", 22, 1.9)</span>
                <span class="row__main" style="gap:2px">
                    <span class="row__title" style="font-weight:800">@Format.Zar(l.Loan.Principal)</span>
                    <span class="row__sub">@l.Loan.Reference · issued @Format.Date(l.Loan.StartDate)</span>
                </span>
                <span class="row__end">
                    <span style="font-weight:700">@(l.IsOpen ? Format.Zar(l.Balance) + " owing" : "Settled")</span>
                    @Ui.Chip(l.Status)
                </span>
            </a>
        }
        @if (Model.Member.Loans.Count == 0)
        {
            <partial name="_EmptyState" model="@(("No loans yet", (string?)$"Loans you record for {p.FirstName} show here.", "default"))" />
        }
    </section>
    <section class="card timeline">
        <h2 class="section-title">Repayment timeline</h2>
        <p class="small muted" style="margin:4px 0 16px">Newest first, with the balance owing after each entry.</p>
        <div>
            @foreach (var e in Model.Timeline)
            {
                <div class="tl">
                    <div class="tl__rail">
                        <span class="tl__dot" style="background:@(e.IsPayment ? "var(--green)" : "var(--gold)")"></span>
                        <span class="tl__line"></span>
                    </div>
                    <div class="tl__body">
                        <div style="min-width:0"><div style="font-weight:700">@e.Title</div><div class="small muted">@Format.Date(e.Date) · @e.Sub</div></div>
                        <div class="tl__end">
                            <div style="font-weight:800;color:@(e.IsPayment ? "var(--ok)" : "var(--ink)")">@(e.IsPayment ? "− " : "+ ")@Format.Zar(Math.Abs(e.Amount))</div>
                            <div class="small muted">Balance @Format.Zar(e.Balance)</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>
